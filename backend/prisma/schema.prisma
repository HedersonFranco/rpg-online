// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Nomenclatura: campos citados literalmente no CLAUDE.md (usuario_id,
// pv/pe/san_atual, pv/pe/san_maximo_cache em Ficha; pastaId/fichaId/npcId
// em Token) usam exatamente a grafia do documento. Os demais campos usam
// camelCase (padrão idiomático do Prisma).

enum PapelSala {
  MESTRE
  JOGADOR
}

// Sistema de regras da sala — escolhido na criação, a ficha herda da sala.
enum Sistema {
  ORDEM_PARANORMAL_1
  ORDEM_PARANORMAL_2
}

enum ClasseOrdemParanormal {
  COMBATENTE
  ESPECIALISTA
  OCULTISTA
}

enum AtributoOrdemParanormal {
  FOR
  AGI
  INT
  VIG
  PRE
}

// Termo oficial do livro é "Destreinado" (não "Leigo").
enum NivelTreinoPericia {
  DESTREINADO
  TREINADO
  VETERANO
  EXPERT
}

// O que o jogador cadastra na própria ficha (OP1). Não é catálogo: cada ficha
// tem as suas entradas, escritas à mão (decisão de 23/09/2026).
enum TipoEntradaFicha {
  RITUAL
  HABILIDADE
  PODER
  EQUIPAMENTO
}

// Elementos do Outro Lado (livro v1.3). VARIA = ritual que muda de elemento
// conforme a versão (ex.: Amaldiçoar Arma).
enum ElementoRitual {
  SANGUE
  MORTE
  CONHECIMENTO
  ENERGIA
  MEDO
  VARIA
}

// Ordem Paranormal RPG II (Playtest Alpha) — perfil psicológico do
// personagem, um dos dois "pilares" da ficha (o outro é a ocupação, que é
// texto livre no playtest, sem catálogo fechado ainda).
enum PerfilOP2 {
  EXECUTOR
  ANALISTA
  VIGILANTE
}

// Escala de step de atributos/perícias de OP2: d4 < d6 < d8 < d10 < d12,
// d20 é exceção pontual liberada por texto específico (não pelo padrão).
enum DadoOP2 {
  d4
  d6
  d8
  d10
  d12
  d20
}

model Usuario {
  id         String   @id @default(uuid())
  nome       String
  email      String   @unique
  senha_hash String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  salasCriadas Sala[]       @relation("SalasCriadas")
  membros      MembroSala[]
  fichas       Ficha[]
  fichasOP2    FichaOP2[]
  mensagens    Mensagem[]
}

model Sala {
  id              String    @id @default(uuid())
  nome            String
  sistema         Sistema
  donoId          String
  conviteToken    String?   @unique
  conviteExpiraEm DateTime?
  // Mapa que a mesa inteira vê agora. Persistido (sobrevive a reinício), ao
  // contrário do combate. Apagar o mapa só zera o campo.
  mapaAtivoId     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  dono       Usuario      @relation("SalasCriadas", fields: [donoId], references: [id])
  mapaAtivo  Mapa?        @relation("MapaAtivo", fields: [mapaAtivoId], references: [id], onDelete: SetNull)
  membros    MembroSala[]
  sessoes    Sessao[]
  fichas     Ficha[]
  fichasOP2  FichaOP2[]
  npcs       Npc[]
  pastas     Pasta[]
  documentos Documento[]
  mapas      Mapa[]       @relation("MapasDaSala")
  mensagens  Mensagem[]
}

model MembroSala {
  id        String    @id @default(uuid())
  usuarioId String
  salaId    String
  papel     PapelSala
  createdAt DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  sala    Sala    @relation(fields: [salaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, salaId])
}

model Sessao {
  id        String   @id @default(uuid())
  salaId    String
  titulo    String?
  createdAt DateTime @default(now())

  sala Sala @relation(fields: [salaId], references: [id], onDelete: Cascade)
}

model Ficha {
  id         String                @id @default(uuid())
  usuario_id String
  salaId     String
  nome       String
  classe     ClasseOrdemParanormal
  origem     String
  trilha     String
  nex        Int                   @default(5)

  for Int
  agi Int
  int Int
  vig Int
  pre Int

  pv_atual         Int
  pv_maximo_cache  Int
  pe_atual         Int
  pe_maximo_cache  Int
  san_atual        Int
  san_maximo_cache Int

  inventario String?
  avatarUrl  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  usuario  Usuario        @relation(fields: [usuario_id], references: [id])
  sala     Sala           @relation(fields: [salaId], references: [id], onDelete: Cascade)
  pericias FichaPericia[]
  entradas FichaEntrada[]
  tokens   Token[]
}

// Habilidades desbloqueadas por classe a cada tier de NEX (5%, 10%, ...,
// 95%, 99%). PV/PE/San NÃO ficam aqui — são fórmula (ClasseFormula) + o
// atributo do personagem, não uma tabela de valores prontos (ver
// engine/calculoFicha.ts e a nota no CLAUDE.md sobre essa correção).
// `habilidades`: múltiplos itens no mesmo tier são separados por ";" (não
// ","), porque o texto de uma única habilidade já pode conter vírgula
// naturalmente — ex. "Ataque especial (2 PE, +5)" é UMA habilidade.
// Ordem Paranormal RPG II (Playtest Alpha) — formato bem diferente de OP1
// (perfil+ocupação+nível em vez de classe+NEX; atributos em dado de step
// em vez de numérico). Tabela separada em vez de esticar Ficha com campos
// nulos, seguindo a decisão já registrada pra D&D. NÃO existe fórmula de
// PV/PD publicada neste playtest — pv_maximo/pd_maximo são valores
// diretamente atribuídos na ficha (pré-prontos ou definidos na criação),
// não calculados por um motor. Perícias ficam em Json (20 perícias fixas,
// ver engine/op2/catalogo.ts) — sem join table própria por ora, dado o
// caráter ainda experimental/playtest deste sistema.
model FichaOP2 {
  id        String    @id @default(uuid())
  usuarioId String
  salaId    String
  nome      String
  perfil    PerfilOP2
  ocupacao  String
  nivel     Int       @default(1)

  fisico DadoOP2
  mente  DadoOP2
  emocao DadoOP2

  pericias Json?

  pv_atual  Int
  pv_maximo Int
  pd_atual  Int
  pd_maximo Int

  habilidades Json?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  sala    Sala    @relation(fields: [salaId], references: [id], onDelete: Cascade)
}

model ProgressaoClasse {
  id          String                @id @default(uuid())
  classe      ClasseOrdemParanormal
  nex         Int
  habilidades String?

  @@unique([classe, nex])
}

// Uma linha fixa por classe: base + incremento por tier de NEX. O motor de
// cálculo soma o atributo do personagem (Vigor pra PV, Presença pra PE;
// Sanidade não soma atributo). Valores confirmados no livro (Ordem
// Paranormal RPG v1.3) — ver CLAUDE.md.
model ClasseFormula {
  classe     ClasseOrdemParanormal @id
  pvBase     Int
  pvPorTier  Int
  peBase     Int
  pePorTier  Int
  sanBase    Int
  sanPorTier Int
}

model Pericia {
  id           String                  @id @default(uuid())
  nome         String                  @unique
  atributoBase AtributoOrdemParanormal

  fichas FichaPericia[]
}

model FichaPericia {
  id        String             @id @default(uuid())
  fichaId   String
  periciaId String
  nivel     NivelTreinoPericia @default(DESTREINADO)

  ficha   Ficha   @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  pericia Pericia @relation(fields: [periciaId], references: [id])

  @@unique([fichaId, periciaId])
}

// Bloco de estatística fixo — não passa pelo motor de cálculo. pe/san são
// de OP1, pd é de OP2; o service rejeita campo do sistema errado pra sala.
model Npc {
  id        String   @id @default(uuid())
  salaId    String
  pastaId   String?
  nome      String
  pv        Int?
  pe        Int?
  san       Int?
  pd        Int?
  atributos String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sala   Sala    @relation(fields: [salaId], references: [id], onDelete: Cascade)
  pasta  Pasta?  @relation(fields: [pastaId], references: [id], onDelete: SetNull)
  tokens Token[]
}

model Pasta {
  id        String   @id @default(uuid())
  salaId    String
  nome      String
  paiId     String?
  createdAt DateTime @default(now())

  sala       Sala        @relation(fields: [salaId], references: [id], onDelete: Cascade)
  pai        Pasta?      @relation("Subpastas", fields: [paiId], references: [id], onDelete: SetNull)
  subpastas  Pasta[]     @relation("Subpastas")
  npcs       Npc[]
  documentos Documento[]
  mapas      Mapa[]
}

model Documento {
  id        String   @id @default(uuid())
  salaId    String
  pastaId   String?
  titulo    String
  conteudo  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sala  Sala   @relation(fields: [salaId], references: [id], onDelete: Cascade)
  pasta Pasta? @relation(fields: [pastaId], references: [id], onDelete: SetNull)
}

model Mapa {
  id        String   @id @default(uuid())
  salaId    String
  pastaId   String?
  nome      String
  imagemUrl String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sala        Sala    @relation("MapasDaSala", fields: [salaId], references: [id], onDelete: Cascade)
  pasta       Pasta?  @relation(fields: [pastaId], references: [id], onDelete: SetNull)
  tokens      Token[]
  salasAtivas Sala[]  @relation("MapaAtivo")
}

// Regra "Token = Ficha, NPC ou objeto genérico (nunca os dois primeiros ao
// mesmo tempo)" é reforçada por CHECK constraint adicionada manualmente na
// migration (fichaId e npcId não podem estar preenchidos simultaneamente).
model Token {
  id        String   @id @default(uuid())
  mapaId    String
  fichaId   String?
  npcId     String?
  nome      String?
  x         Float
  y         Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mapa  Mapa   @relation(fields: [mapaId], references: [id], onDelete: Cascade)
  ficha Ficha? @relation(fields: [fichaId], references: [id], onDelete: SetNull)
  npc   Npc?   @relation(fields: [npcId], references: [id], onDelete: SetNull)
}

model Mensagem {
  id        String   @id @default(uuid())
  salaId    String
  usuarioId String
  conteudo  String
  createdAt DateTime @default(now())

  sala    Sala    @relation(fields: [salaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])
}

// Ritual/habilidade/poder/equipamento da ficha. Colunas específicas de cada
// tipo ficam nulas nos outros tipos — o service rejeita campo do tipo errado.
model FichaEntrada {
  id        String           @id @default(uuid())
  fichaId   String
  tipo      TipoEntradaFicha
  nome      String
  descricao String           @default("")

  circulo      Int? // RITUAL: 1 a 4
  elemento     ElementoRitual? // RITUAL
  preRequisito String? // PODER
  categoria    Int? // EQUIPAMENTO: 0 a 4 (0, I, II, III, IV)
  espacos      Int? // EQUIPAMENTO

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ficha Ficha @relation(fields: [fichaId], references: [id], onDelete: Cascade)

  @@index([fichaId, tipo])
}
