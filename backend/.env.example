DATABASE_URL="postgresql://usuario:senha@localhost:5433/nome_do_banco?schema=public"
# Mínimo 32 caracteres (o servidor não sobe com menos). Gere um com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
PORT=3333

# Onde os mapas enviados são gravados (padrão: backend/uploads)
# UPLOADS_DIR=

# TURN pro vídeo entre redes restritivas (4G, NAT simétrico, rede corporativa).
# Sem isso, só STUN público: funciona na maioria das redes domésticas, não em todas.
# TURN_URL="turn:turn.seudominio.com:3478"
# TURN_USERNAME=""
# TURN_CREDENTIAL=""
